{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../dist",
    "declaration": true,
    "types": [],
    "moduleResolution": "bundler"
  },
  "include": ["**/*.ts", "**/*.css"],
  "exclude": [
    "**/*.test.ts",
    "**/*.react.ts",
    "**/*.stories.ts",
    "**/*.stories.js"
  ],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
